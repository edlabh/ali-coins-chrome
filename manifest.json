{
  "manifest_version": 3,
  "name": "Ali Coins Chrome — Check-in e Tarefas AliExpress",
  "short_name": "Ali Coins",
  "version": "0.2.8",
  "description": "Emula um Pixel 8, faz login no AliExpress, realiza o check-in diário de moedas e executa as tarefas 'Ganhe mais moedas'. Aceita agendamento diário ou execução ao abrir o Chrome, e pausa para o usuário resolver captchas.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Ali Coins — Check-in e Tarefas AliExpress"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "declarativeNetRequest",
    "debugger"
  ],
  "host_permissions": [
    "*://*.aliexpress.com/*",
    "*://*.aliexpress.us/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*"
      ],
      "js": [
        "src/content/selectors.js",
        "src/content/task-classify.js",
        "src/content/ledger.js",
        "src/content/dom.js",
        "src/content/actions.js",
        "src/content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*"
      ],
      "js": [
        "src/content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
